PORT=3000
ELECTRICITY_COST=0.35
PRINTER_WATT=350

# ── SECURITY ────────────────────────────────────────
# Admin-Zugangsdaten für Basic Auth.
# Wenn leer gelassen, werden beim ersten Start sichere Zufallswerte generiert
# und automatisch hier eingetragen.
ADMIN_USER=admin
ADMIN_PASS=

# AES-256-GCM Key für access_code-Verschlüsselung (64 Hex-Zeichen = 32 Bytes).
# Wird beim ersten Start automatisch generiert und hier eingetragen.
ENCRYPTION_KEY=
